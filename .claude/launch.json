{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "pathly-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "web", "--workspace", "@pathly/mobile", "--", "--port", "8081"],
      "port": 8081
    },
    {
      "name": "pathly-site",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["--yes", "firebase-tools@15.32.1", "serve", "--only", "hosting", "--port", "5050"],
      "port": 5050
    }
  ]
}
