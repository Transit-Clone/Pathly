{
  "name": "pathly",
  "version": "0.1.0",
  "private": true,
  "description": "A React Native and Expo prototype for the Pathly transit app.",
  "license": "MIT",
  "workspaces": [
    "mobile",
    "firebase/functions"
  ],
  "engines": {
    "node": ">=24.9.0 <25",
    "npm": ">=11.6.0 <12"
  },
  "packageManager": "npm@11.6.0",
  "scripts": {
    "start": "npm run dev",
    "dev": "npm run dev --workspace @pathly/mobile",
    "dev:web": "npm run web --workspace @pathly/mobile",
    "dev:ios": "npm run ios --workspace @pathly/mobile",
    "dev:android": "npm run android --workspace @pathly/mobile",
    "lint": "npm run lint --workspace @pathly/mobile",
    "test": "npm run test --workspace @pathly/mobile && npm run test --workspace functions",
    "build": "npm run build --workspace @pathly/mobile",
    "typecheck": "npm run typecheck --workspace @pathly/mobile",
    "functions:build": "npm run build --workspace functions",
    "functions:test": "npm run test --workspace functions",
    "functions:shell": "npm run shell --workspace functions",
    "deploy:functions": "npm run build --workspace functions && firebase deploy --only functions"
  },
  "devDependencies": {
    "@fission-ai/openspec": "^1.13.2"
  }
}
