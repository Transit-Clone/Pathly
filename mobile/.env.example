# Firebase public client configuration (safe to include in an app bundle, but still restrict
# the associated API key in Google Cloud to the expected apps/APIs).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Native/web Maps client keys. Restrict by bundle ID, package/SHA fingerprint, or web origin.
GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_IOS_API_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_WEB_API_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_WEB_MAP_ID=

# Accounts that see Admin tools (comma-separated). The backend checks its own ADMIN_EMAILS.
EXPO_PUBLIC_ADMIN_EMAILS=admin@gmail.com

# Web App Check public reCAPTCHA Enterprise site key. Native App Check is configured separately.
EXPO_PUBLIC_FIREBASE_APPCHECK_RECAPTCHA_ENTERPRISE_SITE_KEY=

# Google sign-in OAuth client IDs (Google Cloud -> APIs & Services -> Credentials). Web uses the
# Firebase popup and needs only Google enabled under Firebase Authentication -> Sign-in method;
# iOS and Android need their own client IDs and a development build (not Expo Go).
# The button is hidden on a platform whose ID is missing.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Optional donation page (Ko-fi, Buy Me a Coffee, GitHub Sponsors). Unset hides every "Support Pathly" entry.
EXPO_PUBLIC_DONATION_URL=
