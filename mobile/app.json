{
  "expo": {
    "name": "Pathly",
    "slug": "pathly",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "pathly",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pathly.prototype"
    },
    "android": {
      "package": "com.pathly.prototype",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7FAFF",
          "image": "./assets/pathly-logo.png",
          "imageWidth": 220,
          "resizeMode": "contain"
        }
      ]
    ]
  }
}
