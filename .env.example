# Reference values for shell configuration. This root file is documentation;
# the heartbeat uses these defaults without requiring an environment file.
HOST=0.0.0.0
PORT=3000

# URL that the Expo app uses to reach the API.
# localhost works in a browser and the iOS Simulator. For a physical phone,
# replace localhost with the development computer's LAN IP address.
EXPO_PUBLIC_API_URL=http://localhost:3000
