{
  "name": "functions",
  "version": "0.1.0",
  "private": true,
  "description": "Firebase Cloud Functions for Pathly (Google Maps Platform proxy, server-side logic).",
  "main": "lib/index.js",
  "engines": {
    "node": "24"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "build:gtfs": "npm run build && node scripts/build-gtfs-index.js",
    "test": "npm run build:gtfs && node --test test/*.test.js",
    "serve": "npm run build:gtfs && npx --yes firebase-tools@15.32.1 emulators:start --only functions",
    "shell": "npm run build && npx --yes firebase-tools@15.32.1 functions:shell",
    "deploy": "npx --yes firebase-tools@15.32.1 deploy --only functions",
    "logs": "npx --yes firebase-tools@15.32.1 functions:log"
  },
  "dependencies": {
    "csv-parse": "^7.0.3",
    "fflate": "^0.8.3",
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.0.0",
    "gtfs-realtime-bindings": "^2.2.0"
  },
  "devDependencies": {
    "typescript": "~6.0.3"
  }
}
